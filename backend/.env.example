# Project Settings
PROJECT_NAME="VendorBridge API"
API_V1_STR="/api/v1"

# Security
# Generate a secure secret key using: openssl rand -hex 32
SECRET_KEY="your-super-secret-key-change-me-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vendorbridge
POSTGRES_PORT=5432

# SQLAlchemy Database URL (will be constructed automatically if not set)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vendorbridge

# Email Service Configuration (Optional)
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=user@example.com
SMTP_PASSWORD=password
EMAILS_FROM_EMAIL=info@vendorbridge.com
EMAILS_FROM_NAME="VendorBridge Notifications"
